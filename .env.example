# Marzban Subscription Proxy — environment configuration
#
# Copy to .env and set values for production.
# All variables are optional; the defaults shown below are used if unset.

# Marzban API upstream address (where the proxy forwards requests)
TARGET_SERVICE_URL=http://127.0.0.1:8000

# Port on which the proxy listens
PROXY_PORT=8089

# Enable the Secure flag on session cookies.
# Set to true when serving the admin panel over HTTPS (behind Caddy/nginx).
SECURE_COOKIES=false
