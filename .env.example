# Marzban Subscription Proxy — настройки окружения
#
# В данный момент все настройки задаются константами в main.py.
# Этот файл — справочный. При необходимости значения можно вынести
# в переменные окружения и читать через os.getenv() с fallback-значениями.

# TARGET_SERVICE_URL=http://127.0.0.1:8000
# PROXY_PORT=8089
# CONFIG_DIR=configs
# DB_PATH=subscriptions.db
# CACHE_TTL=30
